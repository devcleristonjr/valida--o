APP_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DATA_HASH_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://pleitos:change-me@localhost:5432/pleitos
ADMIN_USERNAME=serin-admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
RECEPTION_USERNAME=
